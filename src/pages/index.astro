</style>

<script>
	// Folio: the chapter number and title in the margin, updated as chapters pass.
	const folio = document.querySelector<HTMLElement>('.folio');
	const toTop = document.querySelector<HTMLAnchorElement>('.to-top');
	const num = folio?.querySelector('.folio__num');
	const title = folio?.querySelector('.folio__title');
	const chapters = document.querySelectorAll<HTMLElement>('[data-chapter]');
	if (folio && num && title && 'IntersectionObserver' in window) {
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					if (!e.isIntersecting) continue;
					const el = e.target as HTMLElement;
					num.textContent = el.dataset.chapter || '';
					title.textContent = el.dataset.title || '';
					folio.dataset.ground = el.dataset.ground || 'paper';
					folio.classList.toggle('is-on', !!el.dataset.title);
					toTop?.classList.toggle('is-on', !!el.dataset.title);
				}
			},
			{ rootMargin: '-50% 0px -50% 0px' },
		);
		chapters.forEach((c) => io.observe(c));

		// The button sits at the bottom of the screen, so it takes its colours from the
		// chapter under that band, not the one in the middle.
		if (toTop) {
			const under = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (e.isIntersecting) toTop.dataset.ground = (e.target as HTMLElement).dataset.ground || 'paper';
					}
				},
				{ rootMargin: '-94% 0px -3% 0px' },
			);
			chapters.forEach((c) => under.observe(c));
		}
	}

	// The cat watches your pointer. Fine pointers only, and never under reduced motion.
	const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
	const eyes = Array.from(document.querySelectorAll<SVGCircleElement>('[data-cat-eye]'));
	if (!reduce && eyes.length) {
		let px = 0;
		let py = 0;
		let queued = false;
		const look = () => {
			queued = false;
			for (const eye of eyes) {
				const svg = eye.ownerSVGElement;
				if (!svg) continue;
				const r = svg.getBoundingClientRect();
				if (r.bottom < 0 || r.top > innerHeight) continue;
				const vb = svg.viewBox.baseVal;
				const ex = r.left + (eye.cx.baseVal.value / vb.width) * r.width;
				const ey = r.top + (eye.cy.baseVal.value / vb.height) * r.height;
				const dx = px - ex;
				const dy = py - ey;
				const d = Math.hypot(dx, dy) || 1;
				const k = Math.min(d / 160, 1) * 1.8;
				eye.setAttribute('transform', `translate(${((dx / d) * k).toFixed(2)} ${((dy / d) * k).toFixed(2)})`);
			}
		};
		const onMove = (e: PointerEvent) => {
			px = e.clientX;
			py = e.clientY;
			if (!queued) {
				queued = true;
				requestAnimationFrame(look);
			}
		};
		addEventListener('pointermove', onMove, { passive: true });
		addEventListener('pointerdown', onMove, { passive: true });
	}

	// Pet the cat (stroke it with the mouse, or click or tap it) and feed it
	// (drag the fish onto it, or press the button to toss one over).
	const cat = document.querySelector<SVGSVGElement>('[data-cat]');
	const treat = document.querySelector<HTMLButtonElement>('[data-treat]');
	const say = document.querySelector<HTMLElement>('[data-cat-say]');
	if (cat) {
		const HEART =
			'<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21C5 15 2 11.5 2 8c0-3 2.5-5 5-5 2 0 4 1.5 5 3 1-1.5 3-3 5-3 2.5 0 5 2 5 5 0 3.5-3 7-10 13Z"/></svg>';
		const timers = new Map<string, number>();
		const flash = (state: string, ms: number) => {
			cat.classList.add(state);
			clearTimeout(timers.get(state));
			timers.set(state, window.setTimeout(() => cat.classList.remove(state), ms));
		};
		const announce = (text: string) => {
			if (say) say.textContent = text;
		};
		// A point on the cat in page coordinates, from viewBox units.
		const at = (x: number, y: number) => {
			const r = cat.getBoundingClientRect();
			return { x: r.left + (x / 120) * r.width, y: r.top + (y / 120) * r.height };
		};
		const pop = (content: string, x: number, y: number, isText = false) => {
			const el = document.createElement('span');
			el.className = 'cat-pop';
			if (isText) el.textContent = content;
			else el.innerHTML = content;
			el.style.left = `${x + scrollX}px`;
			el.style.top = `${y + scrollY}px`;
			el.style.setProperty('--drift', `${Math.round(Math.random() * 30 - 15)}px`);
			el.addEventListener('animationend', () => el.remove());
			document.body.append(el);
		};

		let pets = 0;
		let lastPet = 0;
		const pet = () => {
			const now = performance.now();
			if (now - lastPet < 450 || cat.classList.contains('is-eating')) return;
			lastPet = now;
			pets++;
			flash('is-happy', 1600);
			const p = at(50 + Math.random() * 30 - 15, 22);
			pop(HEART, p.x, p.y);
			if (pets % 4 === 0) {
				const q = at(88, 40);
				pop('prrr', q.x, q.y, true);
			}
			announce(pets % 4 === 0 ? 'The cat purrs.' : 'You pet the cat.');
		};
		// Stroking: enough mouse travel across the cat counts as a pet.
		let stroke = 0;
		cat.addEventListener('pointermove', (e) => {
			if (e.pointerType !== 'mouse') return;
			stroke += Math.abs(e.movementX) + Math.abs(e.movementY);
			if (stroke > 90) {
				stroke = 0;
				pet();
			}
		});
		cat.addEventListener('pointerleave', () => (stroke = 0));
		cat.addEventListener('pointerdown', pet);
		// Quick repeat clicks count as double and triple clicks, which would select
		// the nearby text. The cat is not text, so its clicks never start a selection.
		cat.addEventListener('mousedown', (e) => e.preventDefault());

		// Feeding. After five treats in a row the cat is full for a while.
		let fed = 0;
		let fullTimer = 0;
		const eat = () => {
			clearTimeout(fullTimer);
			fullTimer = window.setTimeout(() => (fed = 0), 30000);
			const m = at(50, 40);
			if (fed >= 5) {
				flash('is-full', 1100);
				pop('so full', m.x, m.y - 10, true);
				announce('The cat is too full to eat any more.');
				return;
			}
			fed++;
			cat.classList.remove('is-happy');
			flash('is-eating', 900);
			pop('nom', m.x, m.y - 10, true);
			window.setTimeout(() => {
				flash('is-happy', 1800);
				pop(HEART, m.x - 14, m.y);
				pop(HEART, m.x + 14, m.y - 6);
			}, 900);
			announce('The cat eats the treat. Nom.');
		};

		if (treat) {
			const fish = treat.querySelector('.treat__fish');
			const refill = (delay: number) => {
				treat.classList.add('is-empty');
				window.setTimeout(() => {
					treat.classList.remove('is-empty', 'is-dragging');
					treat.classList.add('is-refilled');
					window.setTimeout(() => treat.classList.remove('is-refilled'), 450);
				}, delay);
			};
			const makeHeld = () => {
				const held = document.createElement('div');
				held.className = 'treat-held';
				if (fish) held.append(fish.cloneNode(true));
				document.body.append(held);
				return held;
			};
			// Centre the held fish on a viewport point. left/top, not transform, so the
			// fly animation's own translate moves it from here.
			const place = (el: HTMLElement, x: number, y: number) => {
				el.style.left = `${x - el.offsetWidth / 2}px`;
				el.style.top = `${y - el.offsetHeight / 2}px`;
			};
			const overCat = (x: number, y: number) => {
				const r = cat.getBoundingClientRect();
				const pad = r.width * 0.25;
				return x > r.left - pad && x < r.right + pad && y > r.top - pad && y < r.bottom + pad;
			};

			let held: HTMLElement | null = null;
			let startX = 0;
			let startY = 0;
			let skipClick = false;
			treat.addEventListener('pointerdown', (e) => {
				if (e.button !== 0 || treat.classList.contains('is-empty')) return;
				startX = e.clientX;
				startY = e.clientY;
				treat.setPointerCapture(e.pointerId);
			});
			treat.addEventListener('pointermove', (e) => {
				if (!treat.hasPointerCapture(e.pointerId)) return;
				if (!held) {
					if (Math.hypot(e.clientX - startX, e.clientY - startY) < 6) return;
					held = makeHeld();
					treat.classList.add('is-dragging');
				}
				place(held, e.clientX, e.clientY);
				cat.classList.toggle('is-expecting', overCat(e.clientX, e.clientY));
			});
			const drop = (e: PointerEvent) => {
				if (!held) return;
				const landed = e.type === 'pointerup' && overCat(e.clientX, e.clientY);
				held.remove();
				held = null;
				cat.classList.remove('is-expecting');
				skipClick = true;
				window.setTimeout(() => (skipClick = false), 0);
				if (landed) {
					eat();
					refill(1200);
				} else {
					treat.classList.remove('is-dragging');
				}
			};
			treat.addEventListener('pointerup', drop);
			treat.addEventListener('pointercancel', drop);

			// A click or key press without a drag sends the fish from the button
			// straight to the cat's mouth.
			treat.addEventListener('click', () => {
				if (skipClick || treat.classList.contains('is-empty')) return;
				treat.classList.add('is-empty');
				const home = fish?.getBoundingClientRect() ?? treat.getBoundingClientRect();
				const fromX = home.left + home.width / 2;
				const fromY = home.top + home.height / 2;
				const to = at(50, 58);
				if (reduce) {
					eat();
					refill(1200);
					return;
				}
				cat.classList.add('is-expecting');
				const flying = makeHeld();
				place(flying, fromX, fromY);
				flying
					.animate(
						[
							{ translate: '0 0', scale: '1' },
							{ translate: `${to.x - fromX}px ${to.y - fromY}px`, scale: '0.7' },
						],
						{ duration: 520, easing: 'cubic-bezier(0.5, 0, 0.3, 1)', fill: 'forwards' },
					)
					.finished.then(() => {
						flying.remove();
						cat.classList.remove('is-expecting');
						eat();
						refill(1200);
					});
			});
		}
	}

	// Back to top: smooth unless reduced motion, then hand focus to the top of the page
	// so keyboard users continue from there.
	toTop?.addEventListener('click', (e) => {
		e.preventDefault();
		const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
		scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
		const top = document.getElementById('top');
		if (top) {
			top.setAttribute('tabindex', '-1');
			top.focus({ preventScroll: true });
		}
		history.replaceState(null, '', location.pathname);
	});
</script>
